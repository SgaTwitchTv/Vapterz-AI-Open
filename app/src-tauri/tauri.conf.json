{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vapterz AI Open",
  "version": "0.1.0",
  "identifier": "com.vapterz.ai-open",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Vapterz AI Open",
      "width": 1584,
      "height": 992,
      "minWidth": 1080,
      "minHeight": 700,
      "center": true,
      "decorations": false,
      "resizable": true
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": { "active": false }
}

